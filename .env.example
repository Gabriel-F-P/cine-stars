# Copie este arquivo para .env e preencha os valores.
# Em produção (Railway), configure as mesmas chaves nas variáveis de ambiente do serviço.

# Connection string do Postgres. No Railway, é injetada automaticamente ao
# adicionar o plugin Postgres ao projeto (variável DATABASE_URL do plugin).
DATABASE_URL="postgresql://cinestars:cinestars@localhost:5432/cinestars?schema=public"

# Mercado Pago - obtenha em https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE (sandbox) em desenvolvimento e as de produção (APP_USR-...) no deploy real.
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL pública da aplicação (usada nos back_urls e notification_url do Mercado Pago).
# Em produção, aponte para o domínio real, ex: https://cinestars.com.br
# Importante: por começar com NEXT_PUBLIC_, esse valor é embutido no build do
# Next.js - configure-o no Railway ANTES do primeiro deploy/build.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js - segredo usado para assinar/criptografar os cookies de sessão (JWT).
# Gere um valor novo e único para produção (nunca reaproveite o de desenvolvimento):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Resend - envio de e-mail (redefinição de senha). Crie a conta em https://resend.com,
# gere uma API key e cole abaixo. Sem domínio verificado no Resend, o remetente
# precisa ser "onboarding@resend.dev" e só envia pro seu próprio e-mail de dono da conta.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CineStars <onboarding@resend.dev>"
